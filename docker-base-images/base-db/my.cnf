# MySQL Configuration for Strike7 Benchmarks
# Optimized for development/testing environments

[mysqld]
# Basic Settings
default-authentication-plugin = mysql_native_password
skip-host-cache
skip-name-resolve

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Performance Settings (Relaxed for testing)
max_connections = 200
max_allowed_packet = 64M
key_buffer_size = 16M
table_open_cache = 64
sort_buffer_size = 512K
net_buffer_length = 8K
read_buffer_size = 256K
read_rnd_buffer_size = 512K
myisam_sort_buffer_size = 8M

# Query Cache (Disabled in MySQL 8.0+)
# query_cache_type = 0
# query_cache_size = 0

# Logging (Minimal for performance)
log_error = /var/log/mysql/error.log
slow_query_log = 0
long_query_time = 2

# Binary Logging (Disabled for testing)
skip-log-bin

# InnoDB Settings
innodb_buffer_pool_size = 128M
innodb_log_file_size = 48M
innodb_flush_log_at_trx_commit = 2
innodb_lock_wait_timeout = 50

# Security (Relaxed for isolated test environment)
local_infile = ON
secure_file_priv = ""

# SQL Mode (Permissive for vulnerability testing)
sql_mode = "NO_ENGINE_SUBSTITUTION"

[client]
default-character-set = utf8mb4
